<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OEM DSP &amp; ACOUSTIC SUITE"
                android:textColor="@color/accent_amber"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseAudio"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:text="TUTUP"
                android:textColor="@color/text_secondary" />
        </RelativeLayout>

        <!-- Presets Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetClarity"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="DIESEL CLARITY"
                android:textColor="@color/accent_amber"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetBass"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="DEEP BASS"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetVocal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="VOCAL"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnPresetFlat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="FLAT"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Cabin Sound Stage (Fader / Balance) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kabin Sound Stage (Innova 3 Baris)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStageDriver"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_amber"
                android:text="FOKUS SOPIR (FR)"
                android:textColor="@color/text_inverse"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnStageAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="SEMUA PENUMPANG"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnStageFront"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="HANYA DEPAN"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Speed-Compensated Volume (SVC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_shortcut"
            android:orientation="vertical"
            android:padding="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed-Compensated Volume (SVC)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swSvc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:checked="true" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otomatis menaikkan volume saat melaju kencang di tol untuk mengimbangi suara deru mesin 2KD dan gesekan aspal."
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
