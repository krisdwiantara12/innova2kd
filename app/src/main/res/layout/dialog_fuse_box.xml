<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANDUAN SEKRING DARURAT INNOVA 2KD"
            android:textColor="@color/accent_amber"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseFuse"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:text="TUTUP"
            android:textColor="@color/text_secondary" />
    </RelativeLayout>

    <!-- Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFuseEngine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_amber"
            android:text="RUANG MESIN (DEPAN AKI)"
            android:textColor="@color/text_inverse"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnFuseCabin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="KABIN (BAWAH SETIR)"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- List of Fuses -->
    <ListView
        android:id="@+id/lvFuses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border_subtle"
        android:dividerHeight="1dp" />

</LinearLayout>
