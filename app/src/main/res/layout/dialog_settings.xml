<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="PENGATURAN LAUNCHER"
        android:textColor="@color/accent_amber"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Custom Cockpit Branding Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Kendaraan / Branding Kokpit (Default: SANEPO)"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVehicleBrand"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_shortcut"
        android:hint="Contoh: SANEPO"
        android:paddingHorizontal="12dp"
        android:text="SANEPO"
        android:textColor="@color/accent_amber"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Theme Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Warna Tema Kokpit"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAmber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Innova Amber"
            android:textColor="@color/accent_amber"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/rbCyan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cyber Cyan"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/rbSilver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monochrome"
            android:textColor="@color/accent_silver"
            android:textSize="11sp" />
    </RadioGroup>

    <!-- Speed Limit Warning -->
    <TextView
        android:id="@+id/tvSettingSpeedLimitLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Batas Peringatan Kecepatan (Tol): 100 KM/H"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/sbSpeedLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:max="60"
        android:progress="20"
        android:progressTint="@color/accent_amber"
        android:thumbTint="@color/accent_amber" />

    <!-- Odometer Calibration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kalibrasi Odometer Asli (KM)"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etOdometer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_shortcut"
        android:inputType="number"
        android:paddingHorizontal="10dp"
        android:text="142350"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Section OTA Update -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="@color/border_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_shortcut"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingVersionName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versi Terpasang: v1.0.0-OEM"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Server: github.com/krisdwiantara12/innova2kd"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCheckUpdateNow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/accent_amber"
                android:paddingHorizontal="12dp"
                android:text="🔄 CEK UPDATE"
                android:textColor="@color/text_inverse"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUpdateStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Koneksikan headunit ke hotspot HP untuk cek update."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="BATAL"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_amber"
            android:text="SIMPAN"
            android:textColor="@color/text_inverse" />
    </LinearLayout>

</LinearLayout>
