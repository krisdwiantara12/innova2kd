<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Midnight Space -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#050811"
                android:centerColor="#0B1120"
                android:endColor="#020408"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ambient Glow Top Arc (TRD / Lexus Luxury Ambient Light) -->
    <item android:top="-120dp" android:bottom="400dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#2238BDF8"
                android:centerColor="#0D38BDF8"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="450dp" />
        </shape>
    </item>

    <!-- Ambient Glow Bottom-Left Under Glow -->
    <item android:left="-100dp" android:right="500dp" android:top="200dp" android:bottom="-80dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#18D97706"
                android:centerColor="#08D97706"
                android:endColor="#00000000"
                android:type="radial"
                android:gradientRadius="350dp" />
        </shape>
    </item>

    <!-- Subtle Hex Weave Vignette Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1E293B" />
        </shape>
    </item>
</layer-list>
