<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#33FF9E1B" />
        </shape>
    </item>
    <!-- Badge Core Metallic Plaque -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="90"
                android:startColor="#0D111A"
                android:centerColor="#18202E"
                android:endColor="#0F141F"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#FF9E1B" />
        </shape>
    </item>
</layer-list>
