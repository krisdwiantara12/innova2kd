<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow / Bottom Depth -->
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#06080D" />
        </shape>
    </item>
    <!-- Card Surface (Deep Obsidian Frosted Glass) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#1A2230"
                android:endColor="#0F141E"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#3B4C66" />
        </shape>
    </item>
</layer-list>
