<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow for 3D extrusion -->
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#05070B" />
        </shape>
    </item>
    <!-- Tile Surface -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#202A3B"
                android:centerColor="#141A25"
                android:endColor="#0F141E"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#3D506E" />
        </shape>
    </item>
</layer-list>
